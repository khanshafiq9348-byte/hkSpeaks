# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/tts_platform
# Local Development default fallback: sqlite+aiosqlite:///./data/tts.db
DATABASE_URL=sqlite+aiosqlite:///./data/tts.db

# Redis & Caching
# Production Redis: redis://localhost:6379/0
# Local Development fallback: memory
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / Cloudflare R2 / MinIO / Local)
# Provider choices: 'local', 's3', 'r2', 'minio'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET_NAME=tts-audio-bucket
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL_BASE=http://localhost:8000/v1/storage

# TTS Provider Keys (Optional for local dev, uses Mock provider by default)
MOCK_TTS_ENABLED=true
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Billing & Payments
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits & Quotas
MAX_UPLOAD_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300
DEFAULT_CHUNK_SIZE_CHARS=1000
